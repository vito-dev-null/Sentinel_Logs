# Copy to the ignored .env file and replace each placeholder before using Compose.
# Choose a non-overlapping private IPv4 subnet and distinct usable addresses within it.
SENTINELLOGS_DOCKER_SUBNET=replace-with-non-overlapping-ipv4-cidr
SENTINELLOGS_BACKEND_CONTAINER_ADDRESS=replace-with-backend-address
SENTINELLOGS_NGINX_CONTAINER_ADDRESS=replace-with-nginx-address
